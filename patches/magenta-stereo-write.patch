@@ -118,5 +118,16 @@
     std::atomic<size_t> virtual_capacity_;
 };
 
+// Producer-only paired write. The consumer releases L and R separately, so
+// checking only one channel can publish L while R still has insufficient space.
+// Capacity must remain fixed while the producer and consumer are active.
+inline bool write_stereo(RingBuffer& left, RingBuffer& right,
+                         const float* data_left, const float* data_right,
+                         size_t count) {
+    if (left.free_space() < count || right.free_space() < count) return false;
+    // Only the consumer can change free space now, and it can only increase it.
+    return left.write(data_left, count) && right.write(data_right, count);
+}
+
 }  // namespace core
 }  // namespace magentart
