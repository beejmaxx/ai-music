@@ -118,6 +118,14 @@
     std::atomic<size_t> virtual_capacity_;
 };
 
+// Prime complete model frames while leaving room below the virtual capacity.
+// A zero/undersized capacity gets one checked write, avoiding unsigned underflow.
+inline size_t priming_frame_count(size_t capacity, size_t frame_samples) {
+    if (!frame_samples) return 0;
+    const auto count = capacity ? (capacity - 1) / frame_samples : 0;
+    return count ? count : 1;
+}
+
 // Producer-only paired write. The consumer releases L and R separately, so
 // checking only one channel can publish L while R still has insufficient space.
 // Capacity must remain fixed while the producer and consumer are active.
